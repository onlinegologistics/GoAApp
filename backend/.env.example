# Environment template for the production server (app.goairclass.com).
# Copy this file to `.env` on the server (NEVER commit the real .env) and fill in
# real values. Keep PORT=7001 — the Dockerfile, docker-compose.yml, and the Nginx
# reverse-proxy config in deploy/nginx are all wired to that port.

NODE_ENV=production
PORT=7001

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
MONGO_URI=

# ── Super Admin (seeded on first boot) ────────────────────────────────────────
ADMIN_NAME=Super Admin
ADMIN_MOBILE=
ADMIN_EMAIL=admin@goairclass.com

# ── Razorpay (use LIVE keys in production, not test keys) ─────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET=

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── App URL (used in emails/links) ────────────────────────────────────────────
FRONTEND_URL=https://app.goairclass.com

# ── Cleartrip Hotel B2B ────────────────────────────────────────────────────────
CLEARTRIP_HOTEL_BASE_URL=https://b2b.cleartrip.com/hotels/api/v4
CLEARTRIP_HOTEL_API_KEY=
CLEARTRIP_HOTEL_DA_ID=
CLEARTRIP_HOTEL_LINEAGE_ID=

# ── Cleartrip Flight B2B (switch to the prod base URL when it's issued) ───────
CLEARTRIP_FLIGHT_EMAIL=
CLEARTRIP_FLIGHT_PASSWORD=
CLEARTRIP_FLIGHT_TENANT_ID=
CLEARTRIP_FLIGHT_BASE_URL=https://qa-air-b2b.cleartrip.com/air/api/v4
CLEARTRIP_FLIGHT_API_KEY=
