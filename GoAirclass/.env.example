# Copy to `.env` (gitignored) — read at build time by react-native-dotenv, see babel.config.js.
# Points the app's axios client (src/api/apiClient.ts) at a backend.

# Production (live backend on app.goairclass.com, see backend/DEPLOY.md):
API_URL=https://app.goairclass.com/api

# Local dev against a backend running on your machine instead:
# Android emulator can't reach "localhost" of the host machine — use 10.0.2.2.
# API_URL=http://10.0.2.2:7001/api
# iOS simulator / physical device on the same network can use your machine's LAN IP:
# API_URL=http://192.168.x.x:7001/api
